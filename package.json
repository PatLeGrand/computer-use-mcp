  "exports": {
    ".": "./plugin/computer-use.mjs",
    "./server": "./plugin/computer-use.mjs"
  },
  "bin": {
    "computer-use-mcp": "vendor/bin/computer-use-mcp"
  },
  "files": [
    "plugin/computer-use.mjs",
    "skills/computer-use-mcp/SKILL.md",
    "vendor/bin/computer-use-mcp",
    "README.md",
    "MCP.md",
    "SECURITY.md",
    "LICENSE",
    ".codex-plugin/plugin.json",
    ".agents/plugins/marketplace.json",
