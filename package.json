  },
  "license": "MIT",
  "author": "PatLeGrand",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "engines": {
    "node": ">=22",
    "opencode": ">=1.18.0"
  },
